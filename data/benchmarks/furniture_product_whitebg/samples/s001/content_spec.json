      {
        "id": "S2",
        "check": "无部件穿模/重叠"
      },
      {
        "id": "S3",
        "check": "无部件缺失/多余"
      },
      {
        "id": "S4",
        "check": "整体造型轮廓忠实还原参考图(对照target判断,不预设具体形态)"
