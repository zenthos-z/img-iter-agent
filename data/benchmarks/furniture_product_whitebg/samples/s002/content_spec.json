{
  "sample_id": "s002",
  "product": "弧形软包双人床（浅绿仿皮）",
  "category": "bed",

  "task": {
    "mode": "image_edit",
    "input_assets": ["target.jpg"],
    "instruction": "以该图为参考产品,生成同一张床的三个视角白底素材图:正视图、侧视图(90°)、立体图(45°)。三张必须是同一产品、同色、同比例,纯白背景。",
    "output": {
      "views": ["front", "side", "perspective"],
      "background": "white",
      "size": "2K"
    }
  },

  "constraints": {
    "must_keep": ["弧形拼接床头板", "浅绿色仿皮颜色", "软包质感与缝线包边", "白色床垫及菱形绗缝"],
    "may_change": ["背景(纯白)", "配套床头柜/衣柜(移除,床为唯一主体)", "光影"],
    "must_avoid": ["床头板变平直", "浅绿色变成灰/白", "软包变塑料", "三视图不一致"]
  },

  "checklist": {
    "consistency": [
      {"id": "C1", "check": "三视图是同一张床"},
      {"id": "C2", "check": "三视图浅绿色一致"},
      {"id": "C3", "check": "侧视图床宽=正视图床宽"},
      {"id": "C4", "check": "三视图高度比例一致"}
    ],
    "product_structure": [
      {"id": "S1", "check": "床头板+床框结构齐全", "anchor": "对照 target"},
      {"id": "S2", "check": "无部件穿模/重叠"},
      {"id": "S3", "check": "无部件缺失"},
      {"id": "S4", "check": "床头板仍是弧形拼接(非平直)", "anchor": "对照 target"}
    ],
    "material_texture": {
      "_scoring": "continuous: LLM对这些点整体给0-1还原度分(有偏差,排序校准吸收权重)",
      "points": [
        "软包仿皮质感(柔软感)",
        "有缝线/包边细节(非光滑塑料)",
        "床垫菱形绗缝清晰"
      ]
    },
    "color_accuracy": {
      "_scoring": "continuous: LLM对这些点整体给0-1准确度分(有偏差,排序校准吸收权重)",
      "points": [
        "床头浅绿色(与参考一致)",
        "未变成灰/白/其他色",
        "床垫白色一致"
      ]
    },
    "artifact_defect": [
      {"id": "A1", "check": "床头板边缘曲线流畅无变形"},
      {"id": "A2", "check": "左右对称结构对称"},
      {"id": "A3", "check": "无模糊/拼接痕"},
      {"id": "A4", "check": "家具接地有阴影(不悬浮)"}
    ],
    "commercial_focus": [
      {"id": "B1", "check": "主体居中突出"},
      {"id": "B2", "check": "背景纯白干净"},
      {"id": "B3", "check": "留白构图符合电商规范"}
    ]
  },

  "anchor_for": ["consistency", "product_structure", "material_texture", "color_accuracy"]
}
