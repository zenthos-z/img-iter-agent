{
  "sample_id": "s003",
  "product": "折叠便携躺椅（金属+织物）",
  "category": "lounger",
  "task": {
    "mode": "image_edit",
    "input_assets": [
      "target.jpg"
    ],
    "instruction": "以该图为参考产品,生成【一张】白底素材图,图中并排排版同一把躺椅的三个视角:正视图、侧视图(90°)、立体图(45°)。三个视角必须是同一产品、同色、同比例,纯白背景。一次生成一张完整的三视图排版图。",
    "output": {
      "layout": "three_view_single_image",
      "views": [
        "front",
        "side",
        "perspective"
      ],
      "background": "white",
      "size": "2K"
    }
  },
  "constraints": {
    "must_keep": [
      "折叠框架结构(关节/斜撑)",
      "长条形整体形态",
      "深灰/蓝灰织物",
      "浅米色金属框"
    ],
    "may_change": [
      "背景(纯白)",
      "光影"
    ],
    "must_avoid": [
      "折叠结构变形为普通床腿",
      "长条形态变短变方",
      "织物变光滑塑料",
      "三视角不一致"
    ]
  },
  "checklist": {
