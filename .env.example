# img-iter-agent 环境变量样例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）。
# 前缀统一为 IMG_ITER_。

# --- dmxapi 凭证/地址（Step 3 真正生图时才需要；基础层测试无需配置）---
IMG_ITER_DMXAPI_HOST=https://api.dmxapi.cn
IMG_ITER_DMXAPI_KEY=

# --- 四个协议族的「生图」model_id（用户后填；不同模型价格不同）---
# Family B(豆包Responses): seedream-5.0-pro
IMG_ITER_MODEL_SEEDREAM_PRO=
# Family A(OpenAI Images): gpt-image-2
IMG_ITER_MODEL_GPT_IMAGE=
# Family D(Gemini native): gemini-3.1-flash-image
IMG_ITER_MODEL_GEMINI_IMAGE=
# Family C(Qwen Responses): qwen-image-2.0
IMG_ITER_MODEL_QWEN_IMAGE=

# --- Agent LLM（每个 agent 独立配置；见 ADR-006）---
# Critic 看图打分 → 必须多模态；Generator/Summarizer 文本即可。
# protocol 决定走 dmxapi 的哪个端点/认证：openai(默认最通用) / gemini / doubao / qwen / claude。
IMG_ITER_CRITIC_MODEL=
IMG_ITER_CRITIC_PROTOCOL=openai
IMG_ITER_GENERATOR_MODEL=
IMG_ITER_GENERATOR_PROTOCOL=openai
IMG_ITER_SUMMARIZER_MODEL=
IMG_ITER_SUMMARIZER_PROTOCOL=openai

# --- 数据根目录（默认 = 项目下 data/，一般无需改）---
# IMG_ITER_DATA_ROOT=
